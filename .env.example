PORT=3000
NODE_ENV=development

# Palette & Pillows Business Details
HOST_NAME="Palette & Pillows Hosting"
HOST_PHONE="+91 98765 43210"
HOST_EMAIL="host@paletteandpillows.com"
APP_BASE_URL="http://localhost:3000"

# Society / Building Security Email Details
DEFAULT_SOCIETY_EMAIL="security.society@residentialsociety.com"
DEFAULT_SOCIETY_NAME="Green Valley Heights RWA / Security Office"

# Email Provider Configuration (SMTP / Gmail / Test Mode)
# Leave SMTP_HOST empty to use local test logger / mock preview mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Palette & Pillows <notifications@paletteandpillows.com>"

# Storage Settings
ID_STORAGE_PATH="./uploads/secure_ids"
MAX_FILE_SIZE_MB=10

# Host Admin PIN Protection
ADMIN_PIN=7788
